{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seed",
    "model"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.0.1"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "parameters"
      ],
      "properties": {
        "type": {
          "const": "logistic_regression",
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "C",
            "max_iter"
          ],
          "properties": {
            "C": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000000.0
            },
            "max_iter": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          }
        }
      }
    }
  }
}
