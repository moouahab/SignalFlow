{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interval_seconds",
    "max_samples"
  ],
  "properties": {
    "schema_version": {
      "const": "0.0.1",
      "type": "string"
    },
    "interval_seconds": {
      "type": "number",
      "minimum": 0.02,
      "maximum": 10
    },
    "max_samples": {
      "type": "integer",
      "minimum": 2,
      "maximum": 100000
    },
    "enabled": {
      "type": "boolean"
    },
    "directory": {
      "type": "string",
      "pattern": "^\\./[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*$"
    },
    "prometheus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 104857600
        },
        "backups": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    }
  }
}
