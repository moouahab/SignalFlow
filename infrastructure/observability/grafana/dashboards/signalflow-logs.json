      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "showTime": true,
        "showLabels": false,
        "showLogAttributes": false,
