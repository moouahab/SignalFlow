        {
          "refId": "A",
          "expr": "{service_name=\"signalflow\"} | json | execution_id=~\"$execution_id\" | stage!=\"\" | line_format \"{{.level}} {{.component}}/{{.stage}} {{.event}} run={{.run_id}} exec={{.execution_id}}\"",
