{
  "uid": "signalflow-logs",
  "title": "Logs & Diagnostics",
  "tags": [
    "signalflow",
    "local"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "title": "\u00c9v\u00e9nements SignalFlow",
      "type": "logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"signalflow\"} | json | execution_id=~\"$execution_id\" | line_format \"{{.level}} {{.component}}/{{.stage}} {{.event}} run={{.run_id}} exec={{.execution_id}}\"",
          "legendFormat": "{{phase}}{{name}}{{job}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "showTime": true,
        "showLabels": false,
        "showLogAttributes": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Erreurs",
      "type": "logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"signalflow\"} | json | execution_id=~\"$execution_id\" | level=\"ERROR\" | line_format \"{{.level}} {{.component}}/{{.stage}} {{.event}} run={{.run_id}} exec={{.execution_id}}\"",
          "legendFormat": "{{phase}}{{name}}{{job}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
