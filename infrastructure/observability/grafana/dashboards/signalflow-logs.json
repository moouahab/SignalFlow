    {
      "title": "D\u00e9marrages et finalisations",
      "type": "logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"signalflow\"} | json | execution_id=~\"$execution_id\" | event=~\"train_started|train_succeeded|train_failed|benchmark_succeeded|benchmark_failed\" | line_format \"{{.level}} {{.component}}/{{.stage}} {{.event}} run={{.run_id}} exec={{.execution_id}}\"",
          "legendFormat": "{{phase}}{{name}}{{job}}",
          "queryType": "range"
