    {
      "title": "\u00c9checs cumul\u00e9s (m\u00eame fen\u00eatre temporelle)",
      "type": "timeseries",
      "description": "Corr\u00e9lation temporelle agr\u00e9g\u00e9e ; pas de label run_id dans Prometheus.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "signalflow_trainings_failed_total",
          "legendFormat": "{{phase}}{{name}}{{job}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
