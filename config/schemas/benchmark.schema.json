{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "configurations",
    "repetitions",
    "warmup_repetitions",
    "order_seed",
    "regression_threshold_percent",
    "timeout_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": "0.0.1",
      "type": "string"
    },
    "configurations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "training"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
          },
          "training": {
            "type": "string",
            "pattern": "^\\./.+\\.yaml$"
          }
        }
      }
    },
    "repetitions": {
      "type": "integer",
      "minimum": 2,
      "maximum": 50
    },
    "warmup_repetitions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "order_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "regression_threshold_percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    }
  }
}
