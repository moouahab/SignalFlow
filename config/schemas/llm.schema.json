{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignalFlow Ollama Configuration",
  "$comment": "URL, timeout et options de generation. Aucun secret n'est stocke ici : le nom de variable d'environnement suffit si un proxy exige une cle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ollama", "tracking"],
  "properties": {
    "schema_version": {"const": "0.0.1", "type": "string"},
    "ollama": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "model"],
      "properties": {
        "base_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^https?://[^\\s/?#]+(?:/[A-Za-z0-9._~/-]*)?$"
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 300},
        "max_response_bytes": {"type": "integer", "minimum": 1024, "maximum": 8388608},
        "options": {"$ref": "#/$defs/options"}
      }
    },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experiment_name", "run_name"],
      "properties": {
        "experiment_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "run_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "tracking_uri": {"type": "string", "minLength": 1, "maxLength": 512},
        "native_traces": {"type": "boolean"},
        "log_prompts": {"type": "boolean"},
        "registered_model_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        }
      }
    }
  },
  "$defs": {
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "top_p": {"type": "number", "minimum": 0, "maximum": 1},
        "top_k": {"type": "integer", "minimum": 0, "maximum": 200},
        "num_predict": {"type": "integer", "minimum": 1, "maximum": 32768},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "stop": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    }
  }
}
